{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/pitch_deck.html",
      "destination": "/pitch_deck.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
