{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/pitch_deck.html",
      "destination": "/pitch_deck.html"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|health|pitch_deck\\.html|samples/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
