# Environment Configuration for FlowAgent OS
PORT=3000
NODE_ENV=development

# Avalanche Fuji Testnet (Chain ID: 43113)
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# 0x prefixed 32-byte private key for agent transaction signing
AVALANCHE_PRIVATE_KEY=
# Optional fallback / test recipient address
AVALANCHE_DEFAULT_RECIPIENT=0x000000000000000000000000000000000000dEaD

# ElevenLabs API
ELEVENLABS_API_KEY=
# Default Voice ID (e.g. "21m00Tcm4TlvDq8ikWAM" - Rachel or custom agent voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# U-Bot Integration Webhook Secret / Auth
UBOT_WEBHOOK_SECRET=ubot_dev_secret_token_12345
UBOT_OUTBOUND_WEBHOOK_URL=http://localhost:3000/api/webhook/ubot/mock-receiver
